{
  "name": "warehousd",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "WAREHOUSD_E2E_KEYCLOAK=1 vitest run apps/web/test/sso-keycloak.integration.test.ts",
    "e2e:setup": "tsx scripts/e2e-setup.ts",
    "e2e": "pnpm e2e:setup && pnpm --filter @warehousd/web exec playwright test",
    "e2e:ui": "pnpm --filter @warehousd/web exec playwright test --ui",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "^9.13.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
