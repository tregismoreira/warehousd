{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-heavy.sh",
            "timeout": 15,
            "statusMessage": "Checking for a running suite"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-cleanup.sh",
            "timeout": 120,
            "statusMessage": "Cleaning up"
          }
        ]
      }
    ]
  }
}
