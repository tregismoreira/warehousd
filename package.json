{
  "name": "warehousd",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "tsx scripts/run-tests.ts",
    "test:coverage": "tsx scripts/run-tests.ts --coverage",
    "test:parallel": "vitest run",
    "test:serial": "vitest run --config vitest.serial.config.ts",
    "test:e2e:cli": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:cli:surface": "vitest run --config vitest.e2e.config.ts packages/cli/test/e2e/surface",
    "test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:clean": "tsx scripts/test-clean.ts",
    "test:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e:sso": "WAREHOUSD_E2E_KEYCLOAK=1 vitest run apps/web/test/sso-keycloak.integration.test.ts",
    "test:e2e": "pnpm test:e2e:cli && pnpm test:e2e:sso",
    "e2e:setup": "tsx scripts/e2e-setup.ts",
    "e2e": "pnpm e2e:setup && pnpm --filter @warehousd/web exec playwright test",
    "e2e:ui": "pnpm --filter @warehousd/web exec playwright test --ui",
    "lint": "eslint .",
    "spec": "tsx scripts/api-spec.ts",
    "spec:check": "tsx scripts/api-spec.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsx scripts/typecheck.ts",
    "agent:guard": "bash scripts/agent/guard-heavy.sh",
    "agent:cleanup": "bash scripts/agent/cleanup.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@warehousd/broker": "workspace:*",
    "eslint": "^10.8.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "better-call": "1.3.7",
      "drizzle-orm": "^0.45.2",
      "fast-uri": "^3.1.5",
      "nanoid": "^3.3.17"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5xrq-8626-4rwp",
        "GHSA-fx2h-pf6j-xcff",
        "GHSA-f88m-g3jw-g9cj",
        "GHSA-6g55-p6wh-862q",
        "GHSA-r28c-9q8g-f849"
      ]
    }
  }
}
