{
  // Same split as packages/broker: tsconfig.json emits `src`, this one typechecks src + test
  // without emitting. Kept separate so the suite is checked rather than silently uncompiled.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
